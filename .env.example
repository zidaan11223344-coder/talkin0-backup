# بيانات حساب البوت - ضعها في متغيرات الاستضافة ولا تشاركها
BOT_ID=اسم_حساب_البوت
BOT_PWD=كلمة_مرور_البوت
BOT_MASTER=اسم_حساب_الماستر

# الغرف
GROUP_TO_JOIN=اسم_الغرفة_الأولى
ROOMS=

# الاتصال
API_BASE_URL=https://chatp.net/api?
WS_HOSTS=chatp.net
WS_PATHS=/server
SOCKET_PORT=5335
WS_HEARTBEAT_INTERVAL=25

# الدعوات الخاصة
INVITE_SENDER_NAME=السفير
INVITE_MESSAGE_TEMPLATE=يوجد معجب مخفي في {room}
INVITE_SEND_INTERVAL_SECONDS=0.4

# البيانات الدائمة
BOT_DATA_DIR=admin_data

# GitHub backup
GITHUB_REPO_URL=https://github.com/zidaan11223344-coder/talkin0-backup.git
GITHUB_TOKEN=ضع_التوكن_في_متغيرات_الاستضافة_فقط
